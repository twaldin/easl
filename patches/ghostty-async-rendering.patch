diff --git a/src/renderer/metal/Publication.zig b/src/renderer/metal/Publication.zig
new file mode 100644
index 0000000..99ea21b
--- /dev/null
+++ b/src/renderer/metal/Publication.zig
@@ -0,0 +1,83 @@
+const Publication = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+alloc: Allocator,
+references: std.atomic.Value(usize) = .init(1),
+word: std.atomic.Value(u64) = .init(0),
+
+const Phase = enum(u2) { idle, rendering, ready, publishing };
+const phase_mask: u64 = 3;
+const generation_step: u64 = phase_mask + 1;
+
+pub const Frame = struct {
+    state: *Publication,
+    generation: u64,
+
+    pub fn complete(self: Frame, healthy: bool) void {
+        const next: Phase = if (healthy) .ready else .idle;
+        self.state.word.store(self.generation | @intFromEnum(next), .release);
+    }
+
+    pub fn claim(self: Frame) bool {
+        return self.state.word.cmpxchgStrong(
+            self.generation | @intFromEnum(Phase.ready),
+            self.generation | @intFromEnum(Phase.publishing),
+            .acq_rel,
+            .acquire,
+        ) == null;
+    }
+
+    pub fn finish(self: Frame) void {
+        self.state.word.store(self.generation | @intFromEnum(Phase.idle), .release);
+    }
+};
+
+pub fn create(alloc: Allocator) !*Publication {
+    const state = try alloc.create(Publication);
+    state.* = .{ .alloc = alloc };
+    return state;
+}
+
+pub fn retain(self: *Publication) void {
+    _ = self.references.fetchAdd(1, .monotonic);
+}
+
+pub fn release(self: *Publication) void {
+    if (self.references.fetchSub(1, .acq_rel) == 1)
+        self.alloc.destroy(self);
+}
+
+pub fn begin(self: *Publication) ?Frame {
+    var current = self.word.load(.acquire);
+    while (true) {
+        switch (@as(Phase, @enumFromInt(current & phase_mask))) {
+            .publishing => return null,
+            .rendering => unreachable,
+            .idle, .ready => {},
+        }
+        const generation = (current & ~phase_mask) +% generation_step;
+        if (self.word.cmpxchgWeak(
+            current,
+            generation | @intFromEnum(Phase.rendering),
+            .acq_rel,
+            .acquire,
+        )) |changed| {
+            current = changed;
+        } else return .{ .state = self, .generation = generation };
+    }
+}
+
+pub fn retire(self: *Publication) void {
+    var current = self.word.load(.acquire);
+    while (true) {
+        // An active main callback owns its phase until it returns, even if
+        // that callback tears down the target or the entire renderer.
+        if (@as(Phase, @enumFromInt(current & phase_mask)) == .publishing) return;
+        const generation = (current & ~phase_mask) +% generation_step;
+        if (self.word.cmpxchgWeak(current, generation, .acq_rel, .acquire)) |changed| {
+            current = changed;
+        } else return;
+    }
+}
