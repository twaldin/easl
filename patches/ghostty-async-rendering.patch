+
+// Opt into worker-only rendering on macOS/Metal. Call on the main thread.
+// The callback runs on the main thread after a healthy GPU frame's contents
+// are accepted at the current layer size, including same-IOSurface assignment.
+// It receives the registration's userdata and generation. No callback is made
+// for a discarded frame, a replaced registration, or after surface teardown.
+// Pass NULL to unregister synchronously and restore default synchronous drawing.
+// The caller owns userdata until unregister/free returns. Returns false if
+// unsupported or called off the main thread. This does not report scanout.
+typedef void (*ghostty_surface_frame_cb)(void *userdata, uint64_t generation);
+GHOSTTY_API bool ghostty_surface_set_async_rendering(
+    ghostty_surface_t, ghostty_surface_frame_cb, void *userdata, uint64_t generation);
 GHOSTTY_API void ghostty_surface_set_content_scale(ghostty_surface_t, double, double);
