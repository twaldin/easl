+pub const WakeupCallback = *const fn (?*anyopaque) void;
+
+/// The renderer and queued main-thread publications share this lifetime.
+/// Registration is main-thread-only; atomic fields also reach the render thread.
+const AsyncRendering = struct {
+    alloc: Allocator,
+    references: std.atomic.Value(usize) = .init(1),
+    revision: std.atomic.Value(u64) = .init(0),
+    display_invalidated: std.atomic.Value(bool) = .init(false),
+    callback: FrameCallback = null,
+    userdata: ?*anyopaque = null,
+    generation: u64 = 0,
+    wakeup: ?WakeupCallback = null,
+    wakeup_ctx: ?*anyopaque = null,
+
+    fn retain(self: *AsyncRendering) void {
+        _ = self.references.fetchAdd(1, .monotonic);
+    }
+
+    fn release(self: *AsyncRendering) void {
+        if (self.references.fetchSub(1, .acq_rel) == 1)
+            self.alloc.destroy(self);
+    }
+
+    fn clear(self: *AsyncRendering) void {
+        self.callback = null;
+        self.userdata = null;
+        self.wakeup = null;
+        self.wakeup_ctx = null;
+        self.display_invalidated.store(false, .release);
+        _ = self.revision.fetchAdd(1, .release);
+    }
+};
