{
  "description": "How a terminal whose session is gone resumes the agent it recorded (props.agent's kind, sessionId and, for omp, sessionPath) with the options of its own command: AgentResume.argv in Swift (Sources/CanvasCore/TerminalReference.swift, which the app's tiles run after a reboot) and session.ResumeArgv in Go (easld/internal/session/resume.go, which easld runs for the terminals it owns). Both test suites check every case, so the two can't drift. omp resumes the session file it reported (its --resume takes a path, as agent.restart's does), any other agent its session id. `argv: null` is an agent that can't be resumed (its command runs instead).",
  "cases": [
    { "kind": "omp", "sessionId": "s1", "command": [], "argv": ["omp", "--resume=s1"] },
    { "note": "omp resumes the file it reported, as agent.restart does", "kind": "omp", "sessionId": "s1", "sessionPath": "/home/u/.omp/agent/sessions/-w/s1.jsonl",
      "command": ["omp", "--model=opus"], "argv": ["omp", "--model=opus", "--resume=/home/u/.omp/agent/sessions/-w/s1.jsonl"] },
    { "note": "a file that isn't there (omp's /move renamed it) resumes by id, which omp finds in any project", "kind": "omp", "sessionId": "s1", "sessionPath": "/home/u/.omp/agent/sessions/-w/s1.jsonl",
      "sessionFileGone": true, "command": ["omp", "--model=opus"], "argv": ["omp", "--model=opus", "--resume=s1"] },
    { "note": "an empty session path is no file: by id", "kind": "omp", "sessionId": "s1", "sessionPath": "",
      "command": [], "argv": ["omp", "--resume=s1"] },
    { "note": "only omp's --resume takes a path", "kind": "claude", "sessionId": "u-1", "sessionPath": "/home/u/.claude/projects/-w/u-1.jsonl",
      "command": [], "argv": ["claude", "--resume", "u-1"] },
    { "kind": "claude", "sessionId": "u-1", "command": [], "argv": ["claude", "--resume", "u-1"] },
    { "kind": "codex", "sessionId": "t-1", "command": [], "argv": ["codex", "resume", "t-1"] },
    { "kind": "gemini", "sessionId": "g-1", "command": [], "argv": ["gemini", "--resume", "g-1"] },
    { "kind": "opencode", "sessionId": "ses_1", "command": [], "argv": ["opencode", "--session", "ses_1"] },
    { "kind": "aider", "sessionId": "x", "command": ["aider"], "argv": null },
    { "note": "options after resume, where Codex keeps them; no prompt", "kind": "codex", "sessionId": "t-1",
      "command": ["codex", "-c", "projects.\"/tmp/w\".trust_level=\"trusted\"", "-m", "gpt-6", "fix the build"],
      "argv": ["codex", "resume", "-c", "projects.\"/tmp/w\".trust_level=\"trusted\"", "-m", "gpt-6", "t-1"] },
    { "note": "its own resume is replaced, not doubled", "kind": "codex", "sessionId": "t-2",
      "command": ["codex", "resume", "t-1", "-c", "projects.\"/tmp/w\".trust_level=\"trusted\"", "--last"],
      "argv": ["codex", "resume", "-c", "projects.\"/tmp/w\".trust_level=\"trusted\"", "t-2"] },
    { "note": "a program at a path keeps its path", "kind": "codex", "sessionId": "t-1",
      "command": ["/opt/homebrew/bin/codex", "--dangerously-bypass-approvals-and-sandbox"],
      "argv": ["/opt/homebrew/bin/codex", "resume", "--dangerously-bypass-approvals-and-sandbox", "t-1"] },
    { "note": "a list option keeps its words; the prompt after -- goes", "kind": "claude", "sessionId": "u-2",
      "command": ["claude", "--model", "opus", "--dangerously-skip-permissions", "--resume", "u-1", "--allowed-tools", "Read", "Edit", "--", "write the tests"],
      "argv": ["claude", "--model", "opus", "--dangerously-skip-permissions", "--allowed-tools", "Read", "Edit", "--resume", "u-2"] },
    { "note": "--continue would pick another conversation", "kind": "claude", "sessionId": "u-2",
      "command": ["claude", "-c", "--debug", "--verbose"],
      "argv": ["claude", "--debug", "--verbose", "--resume", "u-2"] },
    { "note": "an optional value is taken only when it isn't an option", "kind": "claude", "sessionId": "u-3",
      "command": ["claude", "--debug", "api", "-w", "--model", "sonnet"],
      "argv": ["claude", "--debug", "api", "-w", "--model", "sonnet", "--resume", "u-3"] },
    { "kind": "omp", "sessionId": "s2",
      "command": ["omp", "--no-extensions", "-e", "/src/easl.ts", "--resume=s1", "--model=opus", "hi"],
      "argv": ["omp", "--no-extensions", "-e", "/src/easl.ts", "--model=opus", "--resume=s2"] },
    { "note": "omp's --resume with a separate value", "kind": "omp", "sessionId": "s3",
      "command": ["omp", "--resume", "s1", "--thinking", "high"],
      "argv": ["omp", "--thinking", "high", "--resume=s3"] },
    { "note": "its project is kept, its prompt isn't", "kind": "opencode", "sessionId": "ses_2",
      "command": ["opencode", "-m", "zai/glm-4.7", "-c", "--prompt", "go", "../app"],
      "argv": ["opencode", "-m", "zai/glm-4.7", "../app", "--session", "ses_2"] },
    { "kind": "gemini", "sessionId": "g-2", "command": ["gemini", "-m", "flash", "-i", "explain", "--yolo"],
      "argv": ["gemini", "-m", "flash", "--yolo", "--resume", "g-2"] },
    { "note": "a command that runs something else says nothing about the agent's options", "kind": "codex", "sessionId": "t-1",
      "command": ["zsh", "-c", "codex -c x"], "argv": ["codex", "resume", "t-1"] },
    { "note": "a lone - is a word, a second -- is a word", "kind": "opencode", "sessionId": "ses_3",
      "command": ["opencode", "-", "--", "--", "dir"], "argv": ["opencode", "-", "--", "dir", "--session", "ses_3"] }
  ]
}
