{
  "description": "Frameless creates, or creates with only w and h, choose a free spot beside group, otherwise beside the caller's terminal, otherwise near the view. Positions depend on the viewport and are excluded. The group cases start empty and compare sizes and membership, not relative placement.",
  "ignore": {
    "response.result.object.frame.x": "placement inside the user's view (client viewport)",
    "response.result.object.frame.y": "placement inside the user's view (client viewport)",
    "events.*.data.frame.x": "placement inside the user's view (client viewport)",
    "events.*.data.frame.y": "placement inside the user's view (client viewport)"
  },
  "steps": [
    {
      "call": "object.create",
      "params": {
        "board": "{{board}}",
        "type": "terminal",
        "props": {
          "cwd": "{{root}}",
          "command": [
            "/bin/cat"
          ]
        },
        "frame": {
          "x": 0,
          "y": 0,
          "w": 600,
          "h": 400
        }
      },
      "save": "t"
    },
    {
      "call": "object.create",
      "params": {
        "board": "{{board}}",
        "type": "shape",
        "props": {
          "kind": "rect"
        },
        "caller": "{{t.object.id}}"
      }
    },
    {
      "call": "object.create",
      "params": {
        "board": "{{board}}",
        "type": "shape",
        "props": {
          "kind": "rect"
        },
        "frame": {
          "w": 300,
          "h": 50
        },
        "caller": "{{t.object.id}}"
      }
    },
    {
      "call": "object.create",
      "params": {
        "board": "{{board}}",
        "type": "code",
        "props": {
          "path": "x.ts"
        }
      },
      "settleMs": 1000
    },
    {
      "call": "object.create",
      "params": {
        "board": "{{board}}",
        "type": "note",
        "props": {
          "markdown": "m"
        },
        "frame": {
          "w": 200,
          "h": 90
        }
      }
    },
    {
      "call": "object.create",
      "params": {"board": "{{board}}", "type": "group", "props": {"members": [], "title": "Create placement"}},
      "save": "createGroup"
    },
    {
      "call": "object.create",
      "params": {"board": "{{board}}", "type": "shape", "group": "{{createGroup.object.id}}", "props": {"kind": "rect"}}
    },
    {
      "call": "object.get",
      "params": {"id": "{{createGroup.object.id}}"}
    },
    {
      "call": "object.create",
      "params": {"board": "{{board}}", "type": "group", "props": {"members": [], "title": "Upsert placement"}},
      "save": "upsertGroup"
    },
    {
      "call": "object.upsert",
      "params": {"board": "{{board}}", "key": "placed-group-member", "type": "shape", "group": "{{upsertGroup.object.id}}", "props": {"kind": "rect"}}
    },
    {
      "call": "object.get",
      "params": {"id": "{{upsertGroup.object.id}}"}
    }
  ]
}
