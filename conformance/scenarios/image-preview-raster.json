{
  "ignore": { "response.error.message": "Host-specific decoder diagnostics are not the error-code contract." },
  "description": "Raster previews preserve natural and output dimensions, source version paths, full-resolution selection, and invalid-raster errors on both hosts.",
  "files": {
    "raster.png": "base64:",
    "broken.png": "base64:iVBORw0KGgo="
  },
  "steps": [
    {
      "call": "object.create",
      "params": {
        "board": "{{board}}",
        "type": "image",
        "props": {
          "path": "raster.png"
        },
        "frame": {
          "x": 0,
          "y": 0,
          "w": 400,
          "h": 200
        }
      },
      "save": "image",
      "expect": {
        "response.ok": true
      }
    },
    {
      "call": "image.preview",
      "params": {
        "id": "{{image.object.id}}",
        "maxPixels": 64
      },
      "expect": {
        "response.ok": true,
        "response.result.kind": "preview",
        "response.result.naturalWidth": 128,
        "response.result.naturalHeight": 64,
        "response.result.width": 64,
        "response.result.height": 32,
        "eventCount": 0
      },
      "expectShape": {
        "response.result": "ImagePreview"
      },
      "ignore": {
        "response.result.data": "Native ImageIO and Go PNG encoders differ; pixel and alpha behavior is checked by each host test suite.",
        "response.result.version.stamp": "Descriptor device, inode, and nanosecond timestamps vary by filesystem and recording."
      }
    },
    {
      "call": "image.preview",
      "params": {
        "id": "{{image.object.id}}",
        "maxPixels": 128
      },
      "expect": {
        "response.ok": true,
        "response.result.kind": "original",
        "eventCount": 0
      },
      "expectShape": {
        "response.result": "ImagePreview"
      }
    },
    {
      "call": "object.update",
      "params": {
        "id": "{{image.object.id}}",
        "props": {
          "path": "broken.png"
        }
      },
      "expect": {
        "response.ok": true
      }
    },
    {
      "call": "image.preview",
      "params": {
        "id": "{{image.object.id}}",
        "maxPixels": 64
      },
      "expect": {
        "response.error.code": "unreadable",
        "eventCount": 0
      }
    }
  ]
}
