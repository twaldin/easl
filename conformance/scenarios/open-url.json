{
  "description": "view.open_url: an http(s) address opens a browser tile beside the caller's terminal, the same address (scheme and host case, default port, empty path normalised) reuses it, other schemes and missing urls are errors; without a caller the tile is placed near the user's view. A browser tile's own props (a named profile, reload when files change) are known props.",
  "serve": {
    "/conformance": "<!doctype html><html><body><p>conformance page</p></body></html>",
    "/other": "<!doctype html><html><body><p>conformance page</p></body></html>",
    "/": "<!doctype html><html><body><p>conformance page</p></body></html>"
  },
  "steps": [
    {
      "call": "object.create",
      "params": {
        "board": "{{board}}",
        "type": "terminal",
        "props": {
          "cwd": "{{root}}",
          "command": [
            "/bin/cat"
          ]
        },
        "frame": {
          "x": 50000,
          "y": 50000,
          "w": 600,
          "h": 400
        }
      },
      "save": "t"
    },
    {
      "call": "view.open_url",
      "params": {
        "board": "{{board}}",
        "url": "http://{{httpHost}}/conformance?q=1#top",
        "caller": "{{t.object.id}}"
      },
      "save": "o1",
      "settleMs": 1500
    },
    {
      "call": "view.open_url",
      "params": {
        "board": "{{board}}",
        "url": "HTTP://{{httpHost}}/conformance?q=1#top",
        "caller": "{{t.object.id}}"
      },
      "settleMs": 500
    },
    {
      "call": "view.open_url",
      "params": {
        "board": "{{board}}",
        "url": "http://{{httpHost}}/conformance?q=2",
        "caller": "{{t.object.id}}"
      },
      "settleMs": 1500
    },
    {
      "call": "view.open_url",
      "params": {
        "board": "{{board}}",
        "url": "http://{{httpHost}}/",
        "caller": "{{t.object.id}}"
      },
      "settleMs": 1500
    },
    {
      "call": "view.open_url",
      "params": {
        "board": "{{board}}",
        "url": "http://{{httpHost}}",
        "caller": "{{t.object.id}}"
      },
      "settleMs": 500
    },
    {
      "call": "view.open_url",
      "params": {
        "board": "{{board}}",
        "url": "ftp://127.0.0.1/file"
      }
    },
    {
      "call": "view.open_url",
      "params": {
        "board": "{{board}}",
        "url": "not a url"
      }
    },
    {
      "call": "view.open_url",
      "params": {
        "board": "{{board}}"
      }
    },
    {
      "call": "view.open_url",
      "params": {
        "board": "{{board}}",
        "url": "http://{{httpHost}}/other"
      },
      "settleMs": 1500,
      "ignore": {
        "response.result.object.frame.x": "placement inside the user's view (client viewport)",
        "response.result.object.frame.y": "placement inside the user's view (client viewport)",
        "events.*.data.frame.x": "placement inside the user's view (client viewport)",
        "events.*.data.frame.y": "placement inside the user's view (client viewport)"
      }
    },
    {
      "call": "board.history",
      "params": {
        "board": "{{board}}"
      },
      "mask": {
        "response.result.entries.5.summary": {
          "match": " at \\(-?[0-9.]+, -?[0-9.]+\\) ",
          "as": " at (<view>) ",
          "why": "the /other tile's creation: placement inside the user's view (client viewport), as in the step before"
        }
      }
    },
    {
      "call": "object.create",
      "params": {
        "board": "{{board}}",
        "type": "browser",
        "props": {
          "url": "http://{{httpHost}}/conformance",
          "profile": "conformance",
          "reloadOnChange": true,
          "bogus": 1
        },
        "frame": {
          "x": 52000,
          "y": 50000,
          "w": 800,
          "h": 600
        }
      },
      "settleMs": 1500
    }
  ]
}
