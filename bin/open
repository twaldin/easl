#!/bin/sh
# easl's open shim, also the tile's $BROWSER: in an easl terminal tile, `open <http(s) url>…` shows
# each address in a browser tile beside the terminal (view.open_url: a tile already showing it is
# reused), and `open <file>…` an existing html, htm, pdf, mp4, m4v or mov file rendered in a
# browser or video tile (view.open_file with rendered: true; one the board would show as code is
# refused). Anything else (other files, apps, flags), a failed call, or a call outside a tile is
# the system's /usr/bin/open, which also stays reachable by its full path.
real=/usr/bin/open

case "$EASL_TILE_ID" in ''|*[!A-Za-z0-9_-]*) exec "$real" "$@" ;; esac
[ $# -gt 0 ] && [ -n "$EASL_SOCKET" ] && [ -S "$EASL_SOCKET" ] && [ -x /usr/bin/nc ] || exec "$real" "$@"

# A file argument as the request names it: absolute, against this directory when relative.
absolute() {
  case "$1" in /*) printf '%s' "$1" ;; *) printf '%s/%s' "$PWD" "$1" ;; esac
}

# Every argument must be a plain URL or an existing page, PDF or video file, safe to put in the
# request as it is.
for arg in "$@"; do
  case "$arg" in
    [hH][tT][tT][pP]://?*|[hH][tT][tT][pP][sS]://?*) value=$arg ;;
    -*) exec "$real" "$@" ;;
    *.[hH][tT][mM][lL]|*.[hH][tT][mM]|*.[pP][dD][fF]|*.[mM][pP]4|*.[mM]4[vV]|*.[mM][oO][vV])
      [ -f "$arg" ] || exec "$real" "$@"
      value=$(absolute "$arg") ;;
    *) exec "$real" "$@" ;;
  esac
  case "$value" in
    *[[:cntrl:][:space:]]*|*'"'*|*\\*) exec "$real" "$@" ;;
  esac
done

work=$(mktemp -d "${TMPDIR:-/tmp}/easl-open.XXXXXX") && mkfifo "$work/in" || exec "$real" "$@"

# Sends one request (`$1`, its params before the caller in `$2`) and waits for its reply line.
# The server drops a connection whose client has stopped sending before it has answered, and nc
# stops sending when its input ends, so its input is a fifo that stays open until the reply is in.
# nc itself only gives up when idle, so the reply is read from a file and nc stopped once it is there.
request() {
  line=
  : >"$work/out"
  /usr/bin/nc -U -w 6 "$EASL_SOCKET" <"$work/in" >"$work/out" 2>/dev/null &
  nc=$!
  exec 3>"$work/in"
  printf '{"id":"1","method":"%s","params":{%s,"caller":"%s"}}\n' "$1" "$2" "$EASL_TILE_ID" >&3
  tries=0
  while [ "$tries" -lt 120 ]; do
    read -r line <"$work/out" && break
    kill -0 "$nc" 2>/dev/null || { read -r line <"$work/out"; break; }
    /bin/sleep 0.05
    tries=$((tries + 1))
  done
  exec 3>&-
  kill "$nc"
  wait "$nc"
  case "$line" in *'"ok":true'*) return 0 ;; esac
  return 1
}

# Each argument the app took is done; what is left (the first it did not take, and the rest) is the system's.
while [ $# -gt 0 ]; do
  case "$1" in
    [hH][tT][tT][pP]://?*|[hH][tT][tT][pP][sS]://?*) request view.open_url "\"url\":\"$1\"" ;;
    *) request view.open_file "\"path\":\"$(absolute "$1")\",\"rendered\":true" ;;
  esac 2>/dev/null || break
  shift
done
rm -rf "$work"
[ $# -eq 0 ] || exec "$real" "$@"
